pipeline {
agent any
environment {
AWS_REGION  = 'ap-south-1'
ACCOUNT_ID  = '123456789012'
ECR_REPO    = 'my-app'
ECR_URI     = "{ACCOUNT_ID}.dkr.ecr.{AWS_REGION}.amazonaws.com/${ECR_REPO}"
IMAGE_TAG   = "${BUILD_NUMBER}"
K8S_NS      = 'dev'
}
stages {
stage('Checkout') {
steps {
checkout scm
}
}
stage('Compile') {
steps {
sh 'mvn clean compile'
}
}
stage('Unit Test') {
steps {
sh 'mvn test'
}
post {
always {
junit 'target/surefire-reports/*.xml'
}
}
}
stage('SonarQube - Source Scan') {
steps {
withSonarQubeEnv('sonarqube') {
sh 'mvn sonar:sonar -Dsonar.projectKey=my-app'
}
}
}
stage('NexusIQ - Artifact Scan') {
steps {
nexusPolicyEvaluation(
iqApplication: 'my-app',
iqStage: 'build',
failBuildOnNetworkError: true
)
}
}
stage('Build') {
steps {
sh 'mvn package -DskipTests'
sh 'docker build -t {ECR_URI}:{IMAGE_TAG} .'
}
}
stage('Trivy - Image Scan') {
steps {
sh 'trivy image --exit-code 1 --severity HIGH,CRITICAL {ECR_URI}:{IMAGE_TAG}'
}
}
stage('Push to ECR') {
steps {
withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
sh '''
aws ecr get-login-password --region {AWS_REGION} | \
docker login --username AWS --password-stdin ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
docker push ${ECR_URI}:${IMAGE_TAG}
'''
}
}
}
stage('Deploy to K8s (Helm)') {
steps {
withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
sh '''
helm upgrade --install my-app ./helm/my-app \
--namespace ${K8S_NS} --create-namespace \
--set image.repository=${ECR_URI} \
--set image.tag={IMAGE_TAG}
'''
}
}
}
}
post {
success { echo 'Pipeline succeeded' }
failure { echo 'Pipeline failed' }
always  { cleanWs() }
}
